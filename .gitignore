# Secrets — never commit
.env
*.env.local

# Python
__pycache__/
*.pyc
.venv/

# Scala / sbt / IDE
target/
project/target/
project/project/
.bloop/
.metals/
.idea/

# scala-cli's own build cache and BSP metadata (compiled .class files,
# machine-specific absolute paths) — generated by running the baseline
# .scala files standalone during Phase 5 testing, not project source
.scala-build/
.bsp/

# Downloaded toolchain (coursier JVM/sbt/scala, winutils) — large binaries,
# reinstall via docs/spec/stage4-scala-toolchain.md instead of committing
.tools/

# Data products that shouldn't be versioned wholesale
data/processed/

# Fine-tuned checkpoints (large, reproducible via nlp/src/train_transformer.py);
# metrics/config JSON are committed separately under experiments/results/
nlp/models/*/
!nlp/models/.gitkeep

# Dashboard runtime state (generated by using the app, not source)
dashboard/backend/audit_log.json

# Scratch directories test_evaluate_end_to_end.py creates and removes per run
compiler/test/.e2e_test_scratch/

# Working copies of the course-deck inputs (the template and the earlier deck
# already tracked under ppt/); only the final deck and ppt/_build are versioned
/format.pptx
/Text analytics (1).pptx
ppt/_build/icons/
ppt/_build/node_modules/

# Generated datasets and raw external data (large, reproducible / not ours to redistribute)
data/generated/
data/external/

# Runtime state (SQLite db, run directories, dataset versions) - generated by using the app
var/

# holdout source pages (rebuild only; fetch with scripts/holdout/fetch_sources.py)
data/holdout/_src/
